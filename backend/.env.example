# ---- Warehouse (your Zoho -> Postgres DB from zoho_postgres_sync.py) ----
# Local example:
DATABASE_URL=postgresql://postgres:YOUR_PG_PASSWORD@localhost:5432/the_balaji
# Docker-compose (bundled sample DB) uses:
# DATABASE_URL=postgresql://ganak:ganak@db:5432/the_balaji

# ---- LLM ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
MODEL=claude-3-5-sonnet-latest
# For OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxx
# MODEL=gpt-4o-mini

# ---- App ----
CURRENCY=₹
ORG_NAME=The Balaji Industries
CORS_ORIGINS=http://localhost:3000
MAX_ROWS=500
STATEMENT_TIMEOUT_MS=15000

# ---- Self-serve connectors (any tenant connects their OWN Zoho/Gmail) ----
# See DEVELOPMENT.md section 6a for how to create these OAuth clients.
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_APP_BASE_URL=http://localhost:3000
GANAK_TOKEN_ENCRYPTION_KEY=
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
